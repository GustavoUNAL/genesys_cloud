# Genesys Cloud API Configuration
# Copia este archivo a .env y completa con tus credenciales
# El archivo .env está en .gitignore y no se subirá al repositorio

# OAuth Client Credentials
# Cliente de tipo Client Credentials creado en la organización
GENESYS_CLIENT_ID=your-client-id-here
GENESYS_CLIENT_SECRET=your-client-secret-here

# Genesys Cloud Region
# Opciones comunes: 'sae1.pure.cloud', 'usw2.pure.cloud', 'useast1.pure.cloud', etc.
GENESYS_REGION=sae1.pure.cloud

# Additional Configuration (optional)
GENESYS_ENVIRONMENT=mypurecloud.com
